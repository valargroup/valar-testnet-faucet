[Unit]
Description=Qualify one public Testnet faucet payout after NU7 activation
After=network-online.target valar-faucet.service

[Service]
Type=oneshot
User=valar-faucet-qualifier
Group=valar-faucet-qualifier
ExecStart=/usr/bin/python3 /opt/valar-faucet-qualification/qualify.py --config /etc/valar-faucet/qualification.json
StateDirectory=valar-faucet-qualification
StateDirectoryMode=0700
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
