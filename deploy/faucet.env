# valar-faucet configuration (non-secret). Loaded by valar-faucet.service from the
# active release, so changes here ship with the next deploy.
# The zecd RPC password arrives via systemd LoadCredential, never through this file.

FAUCET_LISTEN=127.0.0.1:8093
FAUCET_DB=/mnt/data/valar-faucet/app/faucet.db
FAUCET_ZECD_URL=http://127.0.0.1:18890
FAUCET_ZECD_USER=faucet

# 0.125 TAZ per claim; at most 0.125 TAZ per IP (IPv6: per /64) per rolling 24h.
FAUCET_PAYOUT_ZAT=12500000
FAUCET_IP_LIMIT_ZAT=12500000
FAUCET_WINDOW=24h
FAUCET_ADDRESS_COOLDOWN=24h
# Global cap per rolling 24h: 18.75 TAZ (150 claims).
FAUCET_GLOBAL_CAP_ZAT=1875000000
FAUCET_MAX_QUEUE=20
FAUCET_QUEUE_TTL=30m

# Every payout is pushed straight to each Zakura node's sendrawtransaction.
FAUCET_BROADCAST_NODES=zakura-testnet-1=http://127.0.0.1:18232,zakura-testnet-eu=http://164.92.209.78:18232,zakura-testnet-as=http://206.189.148.0:18232

# Caddy on this host sets X-Real-IP; it is only honoured from loopback.
FAUCET_TRUST_PROXY=true
FAUCET_EXPLORER_TX_URL=https://testnet.zcashexplorer.app/transactions/{txid}
FAUCET_STATUS_PAGE_URL=https://status.testnet.zakura.valargroup.dev/
